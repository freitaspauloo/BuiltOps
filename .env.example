# Payload CMS (self-hosted — we own the data)
PAYLOAD_SECRET=
# Local SQLite (default):
DATABASE_URL=file:./payload.db
# Production Postgres (when ready) — Payload switches adapters automatically:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/builtops

# Canonical site URL (preview links + JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hide the dev preview nav widget (version switcher + design system link)
# NEXT_PUBLIC_SHOW_PREVIEW_NAV=false
# Preview / version switcher only mounts under /old (archive).

# Google Maps (Maps JavaScript API + Map Tiles for Advanced Markers)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# Legacy Sanity (superseded by Payload — leave blank)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=
